# Optimizer models. These credentials are not used by the GUI backbone.
# Choose one backend in gui-harvest.toml: "openai" or "openrouter".

# Official OpenAI API.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Official OpenRouter API.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional benchmark checkout for public task metadata.
# GUI_HARVEST_BENCHMARK_ROOT=/path/to/benchmark
